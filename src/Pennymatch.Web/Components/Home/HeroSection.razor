@inject AuthLinkService Auth
@inject ISiteLocalizer L

<section class="hero" aria-labelledby="hero-brand">
    <div class="container hero-grid">
        <div>
            <h1 id="hero-brand" class="hero-brand">Pennymatch</h1>
            <p class="hero-title">@L["Hero.Title"]</p>
            <p class="hero-lead">@L["Hero.Lead"]</p>
            <div class="hero-actions">
                <CtaButton Href="@Auth.RegisterUrl"
                           Variant="primary"
                           Size="lg"
                           Target="_blank"
                           Rel="noopener noreferrer">
                    @L["Hero.CtaRegister"]
                </CtaButton>
                <CtaButton Href="/docs" Variant="secondary" Size="lg">
                    @L["Hero.CtaDocs"]
                </CtaButton>
            </div>
        </div>

        <div class="hero-visual glass-panel journal-flash"
             role="img"
             aria-label="@L["Hero.PipelineAria"]">
            <div class="hero-pipeline" aria-hidden="true">
                <div class="hero-pipe-step">
                    <span class="hero-pipe-label">@L["Hero.Pipe1Label"]</span>
                    <code class="hero-pipe-code">@L["Hero.Pipe1Code"]</code>
                    <span class="hero-pipe-meta">@L["Hero.Pipe1Meta"]</span>
                </div>
                <div class="hero-pipe-arrow" aria-hidden="true">→</div>
                <div class="hero-pipe-step hero-pipe-step-accent">
                    <span class="hero-pipe-label">@L["Hero.Pipe2Label"]</span>
                    <code class="hero-pipe-code">@L["Hero.Pipe2Code"]</code>
                    <span class="hero-pipe-meta">@L["Hero.Pipe2Meta"]</span>
                </div>
                <div class="hero-pipe-arrow" aria-hidden="true">→</div>
                <div class="hero-pipe-step">
                    <span class="hero-pipe-label">@L["Hero.Pipe3Label"]</span>
                    <code class="hero-pipe-code">@L["Hero.Pipe3Code"]</code>
                    <span class="hero-pipe-meta ok">@L["Hero.Pipe3Meta"]</span>
                </div>
            </div>
        </div>
    </div>
</section>
