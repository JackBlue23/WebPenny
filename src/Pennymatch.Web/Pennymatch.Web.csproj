<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Content\blog\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Rebuild Tailwind utilities before compile when Node is available -->
  <Target Name="BuildTailwindCss" BeforeTargets="BeforeBuild" Condition="Exists('package.json')">
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="true"
          Condition="Exists('node_modules/.bin/tailwindcss') Or Exists('node_modules/@tailwindcss/cli')" />
  </Target>

</Project>
