@rendermode InteractiveServer
@implements IDisposable
@inject ISiteLocalizer L
@inject IJSRuntime JS
@inject NavigationManager Nav

<details class="lang-switch" data-lang-switch @ref="_root">
    <summary class="lang-switch-summary" aria-label="@L["Lang.Switch"]">
        <svg class="lang-switch-globe" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3a14 14 0 0 1 0 18" />
            <path d="M12 3a14 14 0 0 0 0 18" />
        </svg>
        <span class="lang-switch-label">@L.Culture.ActiveLabel</span>
        <svg class="lang-switch-chevron" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6" />
        </svg>
    </summary>
    <div class="lang-switch-menu" role="menu" aria-label="@L["Lang.Switch"]">
        <button type="button"
                class="lang-switch-option @(L.Culture.Code == "es" ? "is-active" : null)"
                role="menuitem"
                lang="es"
                disabled="@_busy"
                @onclick="SwitchToEsAsync">@L["Lang.Esp"]</button>
        <button type="button"
                class="lang-switch-option @(L.Culture.Code == "en" ? "is-active" : null)"
                role="menuitem"
                lang="en"
                disabled="@_busy"
                @onclick="SwitchToEnAsync">@L["Lang.Eng"]</button>
    </div>
</details>

@code {
    private ElementReference _root;
    private bool _busy;
    private bool _subscribed;

    protected override void OnInitialized()
    {
        // Keep interactive island aware of enhanced navigations (Docs/Blog/anchors).
        // Destination itself is always taken from window.location at click — never a stale C# field.
        Nav.LocationChanged += OnLocationChanged;
        _subscribed = true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close the dropdown after in-app navigation so the next open is a fresh click.
        _ = CloseDetailsAsync();
    }

    private Task SwitchToEsAsync() => SwitchAsync("es");

    private Task SwitchToEnAsync() => SwitchAsync("en");

    private async Task SwitchAsync(string culture)
    {
        if (_busy || string.Equals(culture, L.Culture.Code, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _busy = true;
        try
        {
            // Infallible path: JS reads window.location (path+search+hash) + scrollY at click time,
            // writes sessionStorage, sets scrollRestoration=manual, then assigns /culture/set?...
            // Never NavigateTo("/") and never trust a render-time href/returnUrl.
            await JS.InvokeVoidAsync("pennyLangSwitch.switchCulture", culture);
        }
        catch (JSDisconnectedException)
        {
            _busy = false;
        }
        catch (JSException)
        {
            _busy = false;
        }
        catch (InvalidOperationException)
        {
            _busy = false;
        }
    }

    private async Task CloseDetailsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pennyLangSwitch.closeSwitcher", _root);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public void Dispose()
    {
        if (_subscribed)
        {
            Nav.LocationChanged -= OnLocationChanged;
            _subscribed = false;
        }
    }
}
