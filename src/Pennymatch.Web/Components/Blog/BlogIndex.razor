@page "/blog"
@inject BlogContentService Blog
@inject ISiteLocalizer L

<PageTitle>@L["Blog.Title"]</PageTitle>
<HeadContent>
    <SeoTags Title="@L["Blog.Title"]"
             Description="@L["Blog.Description"]"
             OgDescription="@L["Blog.OgDescription"]"
             Path="/blog" />
</HeadContent>

<section class="page-hero">
    <div class="container">
        <p class="section-kicker">@L["Blog.Kicker"]</p>
        <h1>@L["Blog.Heading"]</h1>
        <p class="section-lead">@L["Blog.Lead"]</p>
    </div>
</section>

<section class="container blog-grid" aria-label="@L["Blog.ArticlesAria"]">
    @foreach (var post in _posts)
    {
        <a class="blog-card-link" href="@($"/blog/{post.Slug}")">
            <div class="blog-meta">
                <span>@post.Category</span>
                <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">@post.PublishedAt.ToString("d MMM yyyy")</time>
                <span>@string.Format(L["Blog.ReadingMin"], post.ReadingMinutes)</span>
            </div>
            <h2>@post.Title</h2>
            <p>@post.Description</p>
        </a>
    }
</section>

@code {
    private IReadOnlyList<BlogPost> _posts = [];

    protected override void OnInitialized()
    {
        _posts = Blog.GetAll();
    }
}
