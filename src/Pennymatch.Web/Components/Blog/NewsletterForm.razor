@inject ISiteLocalizer L

<div class="newsletter">
    <h2>@L["Newsletter.Title"]</h2>
    <p style="font-size:var(--pm-text-sm);margin-bottom:0.75rem;">
        @L["Newsletter.Lead"]
    </p>

    @if (Submitted)
    {
        <p class="newsletter-msg" role="status">@L["Newsletter.Thanks"]</p>
    }
    else
    {
        <form method="post" @formname="newsletter" data-enhance>
            <AntiforgeryToken />
            <label class="sr-only" for="newsletter-email">@L["Newsletter.Email"]</label>
            <input id="newsletter-email"
                   class="@(Invalid ? "invalid" : null)"
                   name="email"
                   type="email"
                   value="@Email"
                   placeholder="@L["Newsletter.Placeholder"]"
                   required />
            @if (Invalid)
            {
                <p class="validation-message">@L["Newsletter.Invalid"]</p>
            }
            <button type="submit" class="btn btn-primary">@L["Newsletter.Submit"]</button>
        </form>
    }
</div>

@code {
    [SupplyParameterFromForm(FormName = "newsletter")]
    private string? Email { get; set; }

    private bool Submitted { get; set; }
    private bool Invalid { get; set; }

    protected override void OnParametersSet()
    {
        if (Email is null)
        {
            return;
        }

        Invalid = string.IsNullOrWhiteSpace(Email) || !Email.Contains('@');
        if (!Invalid)
        {
            // Marketing-site capture only — wire to ESP later.
            Submitted = true;
        }
    }
}
