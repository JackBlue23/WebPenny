@rendermode InteractiveServer
@inject AuthLinkService Auth
@inject ISiteLocalizer L

<section class="section pricing-section" id="precios" aria-labelledby="pricing-title">
    <div class="container">
        <header class="pricing-header">
            <h2 id="pricing-title" class="pricing-title">@L["Pricing.Title"]</h2>
            <p class="pricing-subtitle">@L["Pricing.TrialNote"]</p>
        </header>

        <div class="pricing-controls" role="group" aria-label="@L["Pricing.BillingAria"]">
            <div class="pricing-segment" role="group" aria-label="@L["Pricing.BillingAria"]">
                <button type="button"
                        class="pricing-chip @(!_yearly ? "is-active" : null)"
                        aria-pressed="@(!_yearly)"
                        @onclick="() => _yearly = false">
                    @L["Pricing.Monthly"]
                </button>
                <button type="button"
                        class="pricing-chip @(_yearly ? "is-active" : null)"
                        aria-pressed="@_yearly"
                        @onclick="() => _yearly = true">
                    @L["Pricing.Yearly"]
                </button>
                <span class="pricing-save">@L["Pricing.SaveBadge"]</span>
            </div>
            <div class="pricing-segment" role="group" aria-label="@L["Pricing.CurrencyAria"]">
                <button type="button"
                        class="pricing-chip @(_currencyUsd ? null : "is-active")"
                        aria-pressed="@(!_currencyUsd)"
                        @onclick="() => _currencyUsd = false">
                    @L["Pricing.CurrencyEur"]
                </button>
                <button type="button"
                        class="pricing-chip @(_currencyUsd ? "is-active" : null)"
                        aria-pressed="@_currencyUsd"
                        @onclick="() => _currencyUsd = true">
                    @L["Pricing.CurrencyUsd"]
                </button>
            </div>
        </div>

        <div class="pricing-grid">
            @foreach (var plan in Plans)
            {
                var href = Auth.BuildPricingRegisterUrl(plan.Id, _yearly, _currencyUsd ? "USD" : "EUR");
                <article class="plan @(plan.Highlighted ? "featured" : null)">
                    <div class="plan-top">
                        @if (plan.Highlighted)
                        {
                            <span class="plan-badge">@L["Pricing.Recommended"]</span>
                        }
                        <h3 class="plan-name">@L[plan.NameKey]</h3>
                        <p class="plan-price">
                            @PriceLabel(plan.Id)
                            <span>@(_yearly ? L["Pricing.PerYear"] : L["Pricing.PerMonth"])</span>
                        </p>
                        <p class="plan-summary">@L[plan.SummaryKey]</p>
                        <ul class="plan-features">
                            @foreach (var featureKey in plan.FeatureKeys)
                            {
                                <li>@L[featureKey]</li>
                            }
                        </ul>
                    </div>
                    <div class="plan-cta">
                        <CtaButton Href="@href"
                                   Variant="@(plan.Highlighted ? "primary" : "secondary")"
                                   Target="_blank"
                                   Rel="noopener noreferrer">
                            @L["Pricing.StartTrial"]
                        </CtaButton>
                        <p class="plan-trial-hint">@L["Pricing.TrialHint"]</p>
                    </div>
                </article>
            }
        </div>

        <p class="pricing-footnote">@L["Pricing.Footnote"]</p>
    </div>
</section>

@code {
    private bool _yearly;
    private bool _currencyUsd;

    private static readonly PlanCard[] Plans =
    [
        new("growth", "Pricing.Growth.Name", "Pricing.Growth.Summary", false,
        [
            "Pricing.Growth.F1",
            "Pricing.Growth.F2",
            "Pricing.Growth.F3",
            "Pricing.Growth.F4",
            "Pricing.Growth.F5"
        ]),
        new("pro", "Pricing.Pro.Name", "Pricing.Pro.Summary", true,
        [
            "Pricing.Pro.F1",
            "Pricing.Pro.F2",
            "Pricing.Pro.F3",
            "Pricing.Pro.F4",
            "Pricing.Pro.F5"
        ]),
        new("enterprise", "Pricing.Enterprise.Name", "Pricing.Enterprise.Summary", false,
        [
            "Pricing.Enterprise.F1",
            "Pricing.Enterprise.F2",
            "Pricing.Enterprise.F3",
            "Pricing.Enterprise.F4",
            "Pricing.Enterprise.F5"
        ])
    ];

    private string PriceLabel(string planId) => (planId, _currencyUsd, _yearly) switch
    {
        ("growth", false, false) => "79 €",
        ("growth", true, false) => "$89",
        ("growth", false, true) => "790 €",
        ("growth", true, true) => "$890",
        ("pro", false, false) => "199 €",
        ("pro", true, false) => "$219",
        ("pro", false, true) => "1.990 €",
        ("pro", true, true) => "$2,190",
        ("enterprise", false, false) => "399 €",
        ("enterprise", true, false) => "$439",
        ("enterprise", false, true) => "3.990 €",
        ("enterprise", true, true) => "$4,390",
        _ => _currencyUsd ? "$0" : "0 €"
    };

    private sealed record PlanCard(
        string Id,
        string NameKey,
        string SummaryKey,
        bool Highlighted,
        string[] FeatureKeys);
}
