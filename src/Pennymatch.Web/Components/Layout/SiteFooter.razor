@inject AuthLinkService Auth
@inject ISiteLocalizer L

<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a class="nav-brand" href="/">
                    <span class="nav-logo-mark" aria-hidden="true">P</span>
                    <span>Pennymatch</span>
                </a>
                <p style="margin-top:0.85rem;max-width:32ch;">
                    @L["Footer.Blurb"]
                </p>
            </div>
            <div>
                <h2>@L["Footer.Product"]</h2>
                <ul>
                    <li><a href="/#simulador">@L["Nav.Simulator"]</a></li>
                    <li><a href="/#ventajas">@L["Nav.Advantages"]</a></li>
                    <li><a href="/docs">@L["Footer.Manuals"]</a></li>
                    <li><a href="@Auth.RegisterUrl" target="_blank" rel="noopener noreferrer">@L["Footer.Trial"]</a></li>
                </ul>
            </div>
            <div>
                <h2>@L["Footer.Resources"]</h2>
                <ul>
                    <li><a href="/blog">@L["Nav.Blog"]</a></li>
                    <li><a href="/docs">@L["Nav.Docs"]</a></li>
                    <li><a href="@Auth.LoginUrl" target="_blank" rel="noopener noreferrer">@L["Footer.Login"]</a></li>
                    <li><a href="@Auth.RegisterUrl" target="_blank" rel="noopener noreferrer">@L["Footer.Register"]</a></li>
                </ul>
            </div>
            <div>
                <h2>@L["Footer.Legal"]</h2>
                <ul>
                    <li><a href="/legal-notice">@L["Footer.LegalNotice"]</a></li>
                    <li><a href="/privacy">@L["Footer.Privacy"]</a></li>
                    <li><a href="/terms">@L["Footer.Terms"]</a></li>
                    <li><a href="/cookies">@L["Footer.Cookies"]</a></li>
                    <li><a href="/subprocessors">@L["Footer.Subprocessors"]</a></li>
                </ul>
            </div>
        </div>
        <p class="footer-copy">@string.Format(L["Footer.Copy"], DateTime.UtcNow.Year)</p>
    </div>
</footer>
