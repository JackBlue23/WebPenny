@page "/"
@inject ISiteLocalizer L
@inject PublicUrlService Urls

<PageTitle>@L["Home.Title"]</PageTitle>
<HeadContent>
    <SeoTags Title="@L["Home.Title"]"
             Description="@L["Home.Description"]"
             OgDescription="@L["Home.OgDescription"]"
             Path="/"
             JsonLd="@JsonLdBuilder.SoftwareApplication(Urls.Origin + "/")" />
</HeadContent>

<HeroSection />
<FlowSimulator @key="@($"sim-{L.Culture.Code}")" CultureCode="@L.Culture.Code" />
<AdvantagesSection />
<PricingSection @key="@($"pricing-{L.Culture.Code}")" CultureCode="@L.Culture.Code" />
<DocsTeaserSection />
<CtaBandSection />
