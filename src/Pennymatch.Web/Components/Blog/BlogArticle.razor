@page "/blog/{Slug}"
@inject BlogContentService Blog
@inject ISiteLocalizer L
@inject PublicUrlService Urls

@if (_post is null)
{
    <PageTitle>@L["Blog.NotFoundTitle"]</PageTitle>
    <section class="page-hero">
        <div class="container">
            <h1>@L["Blog.NotFoundHeading"]</h1>
            <p class="section-lead">
                @L["Blog.NotFoundLead"] <a href="/blog">@L["Blog.Back"]</a>.
                <code>@Slug</code>
            </p>
        </div>
    </section>
}
else
{
    <PageTitle>@(TrimTitle($"{_post.Title} — Pennymatch"))</PageTitle>
    <HeadContent>
        <SeoTags Title="@TrimTitle(_post.Title)"
                 Description="@TrimDesc(_post.Description)"
                 Path="@($"/blog/{_post.Slug}")"
                 OgType="article"
                 JsonLd="@JsonLdBuilder.Article(_post, Urls.Canonical($"/blog/{_post.Slug}"))" />
        <meta name="author" content="@_post.Author" />
        <meta property="article:published_time" content="@_post.PublishedAt.ToString("yyyy-MM-dd")" />
    </HeadContent>

    <article class="container article-layout">
        <div>
            <header class="article-header">
                <div class="blog-meta">
                    <span>@_post.Category</span>
                    <time datetime="@_post.PublishedAt.ToString("yyyy-MM-dd")">@_post.PublishedAt.ToString("d MMM yyyy")</time>
                    <span>@string.Format(L["Blog.ReadingMin"], _post.ReadingMinutes)</span>
                    <span>@_post.Author</span>
                </div>
                <h1>@_post.Title</h1>
                <p class="section-lead">@_post.Description</p>
            </header>
            <div class="prose">
                @((MarkupString)_post.Html)
            </div>
        </div>
        <BlogSidebar Posts="_recommended" />
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private BlogPost? _post;
    private IReadOnlyList<BlogPost> _recommended = [];

    protected override void OnParametersSet()
    {
        _post = Blog.GetBySlug(Slug);
        _recommended = Blog.GetRecommended(Slug);
    }

    private static string TrimTitle(string value) =>
        value.Length <= 60 ? value : value[..57].TrimEnd() + "…";

    private static string TrimDesc(string value) =>
        value.Length <= 155 ? value : value[..152].TrimEnd() + "…";
}
